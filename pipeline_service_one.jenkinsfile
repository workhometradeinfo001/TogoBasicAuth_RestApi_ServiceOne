pipeline {
    agent any
    tools {
        maven 'Maven'
    }
    environment {
        MONGODB_URI = "${env.JENKINS_MONGODB_URI}"
        MONGODB_DB = "${env.JENKINS_MONGODB_DB}"
        REDIS_HOST = "${env.JENKINS_REDIS_HOST}"
        REDIS_PORT = "${env.JENKINS_REDIS_PORT}"
        REDIS_PASSWORD = "${env.JENKINS_REDIS_PASSWORD}"
        MAIL_USERNAME = "${env.JENKINS_MAIL_USERNAME}"
        MAIL_PASSWORD = "${env.JENKINS_MAIL_PASSWORD}"
        GOOGLE_CLIENT_ID = "${env.JENKINS_GOOGLE_CLIENT_ID}"
        GOOGLE_CLIENT_SECRET = "${env.JENKINS_GOOGLE_CLIENT_SECRET}"
        JWT_SECRET_CODE = "${env.JENKINS_JWT_SECRET_CODE}"
        ODB_NAME = "${env.JENKINS_ODB_NAME}"
        ODB_OFFICIAL_DB = "${env.JENKINS_ODB_OFFICIAL_DB}"
        ODB_SOURCE = "${env.JENKINS_ODB_SOURCE}"
        SONAR_TOKEN = "${env.SONAR_TOKEN}"
        SONAR_ORG_KEY = "${env.SONAR_ORG_KEY}"
        SONAR_PRO_KEY = "${env.SONAR_PRO_KEY}"
        JAR_FILE_FROM_JENKINS = "${env.JAR_FILE_FROM_JENKINS}"
    }
    stages {
        stage("Print ENV Variables") {
            steps {
                echo "${SONAR_PRO_KEY}"
                echo "${SONAR_ORG_KEY}"
                echo "${SONAR_TOKEN}"
            }
            post {
                always { echo "Print Always ..." }
                success { echo "Print Env Successful" }
                failure { echo "Env Print failure...." }
            }
        }
        stage("Test Github code") {
            steps {
                sh "mvn clean test"
            }
            post {
                always { echo "========always========" }
                success { echo "========Successful mvn Test.========" }
                failure { echo "========Failed mvn Test.========" }
            }
        }
        stage("Build Jar") {
            steps {
                sh '''
                    mvn clean package
                    ls
                    pwd
                '''
            }
            post {
                always { echo "====++++always++++====" }
                success { echo "====++++Successful build jar.++++====" }
                failure { echo "====++++Failed build jar.++++====" }
            }
        }
        stage("Test Code Quality") {
            steps {
                sh """
                    mvn verify sonar:sonar \
                    -Dsonar.projectKey=${SONAR_PRO_KEY} \
                    -Dsonar.organization=${SONAR_ORG_KEY} \
                    -Dsonar.host.url=https://sonarcloud.io \
                    -Dsonar.token=${SONAR_TOKEN}
                """
            }
            post {
                always { echo "====++++always++++====" }
                success { echo "====++++Successful check sonarqube++++====" }
                failure { echo "====++++Failed sonarqube check++++====" }
            }
        }
        stage("Copy jar and past into with Dockerfile."){
            steps{
                sh """
                    cp ${JAR_FILE_FROM_JENKINS} .
                """
            }
            post{
                always{echo "===Always Run====="}
                success{echo "====Copy jar success====="}
                failure{echo "====Failed to copy jar====="}
            }
        }
        stage("Build Docker Image with jar"){
            steps{
                sh """
                docker build -f Dockerfile.dockerfile --build-arg JAR_FILE_PATH=RestApi_Service_One.jar -t service-one .
                """
                }
            post{
                always{echo "======Always======"}
                success{echo "=====Build Docker image Successful======"}
                failure{echo "=======Build Docker image Failed========"}
            }
        }
    } // End of Stages

    post {
        always { echo "========always Check Post========" }
        success { echo "========pipeline executed successfully ========" }
        failure { echo "========pipeline execution failed========" }
    }
} // End of Pipeline
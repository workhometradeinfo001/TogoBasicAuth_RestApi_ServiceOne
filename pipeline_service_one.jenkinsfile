pipeline{
    agent any
    tools {
        maven 'Maven'
    }
    environment {
        MONGODB_URI = "${env.JENKINS_MONGODB_URI}"
        MONGODB_DB = "${env.JENKINS_MONGODB_DB}"
        REDIS_HOST = "${env.JENKINS_REDIS_HOST}"
        REDIS_PORT = "${env.JENKINS_REDIS_PORT}"
        REDIS_PASSWORD = "${env.JENKINS_REDIS_PASSWORD}"
        MAIL_USERNAME = "${env.JENKINS_MAIL_USERNAME}"
        MAIL_PASSWORD = "${env.JENKINS_MAIL_PASSWORD}"
        GOOGLE_CLIENT_ID = "${env.JENKINS_GOOGLE_CLIENT_ID}"
        GOOGLE_CLIENT_SECRET = "${env.JENKINS_GOOGLE_CLIENT_SECRET}"
        JWT_SECRET_CODE = "${env.JENKINS_JWT_SECRET_CODE}"
        ODB_NAME = "${env.JENKINS_ODB_NAME}"
        ODB_OFFICIAL_DB = "${env.JENKINS_ODB_OFFICIAL_DB}"
        ODB_SOURCE = "${env.JENKINS_ODB_SOURCE}"
        SONAR_TOKEN = credentials("SONAR_TOKEN")
    }
    stages{
        stage("Print ENV Variables"){
            steps{
                sh "printenv"
            }
            post{
                always{
                    echo "Print Always ..."
                }
                success{
                    echo "Print Env Successful"
                }
                failure{
                   echo "Env Print failure...."
                }
            }
        }
        stage("Test Gitbub code"){
            steps{
                sh "mvn clean test"
            }
            post{
                always{
                    echo "========always========"
                }
                success{
                    echo "========Successfull mvn Test.========"
                }
                failure{
                    echo "========Failed mvn Test.========"
                }
            }
        }
        stage("Build Jar"){
            steps{
                sh '''mvn clean package
                ls
                pwd
                '''
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++Successful build jar.++++===="
                }
                failure{
                    echo "====++++Failed build jar.++++===="
                }
            }
        }
        stage("Test Code Quality"){
            steps{
                withSonarQubeEnv("SonarQubeServer"){
                    sh """
                        mvn verify sonar:sonar \
                        -Dsonar.projectKey=your_project_key \
                        -Dsonar.organization=your_org_key \
                        -Dsonar.host.url=https://sonarcloud.io \
                        -Dsonar.login=${SONAR_TOKEN}
                    """
                }
            }
            post{
                always{
                    echo "====++++always++++===="
                }
                success{
                    echo "====++++Successful check sonarqube++++===="
                }
                failure{
                    echo "====++++Failed sonarqube check++++===="
                }
            }
        }
    }
    post{
        always{
            echo "========always Check Post========"
        }
        success{
            echo "========pipeline executed successfully ========"
        }
        failure{
            echo "========pipeline execution failed========"
        }
    }
}